# ==============================================================================
# .gitignore for Django & Wagtail Project (SmartFlow AI CRM & ERP)
# ==============================================================================

# 1. Environment & Sensitive Data (Bảo mật & Biến môi trường)
.env
.env.*
!.env.example
*.pem
*.key

# 2. Virtual Environments (Môi trường ảo Python)
venv/
venv*/
env/
env*/
.venv/
.venv*/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache (Bộ nhớ đệm & File biên dịch Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 4. Django & Wagtail Specific (Cơ sở dữ liệu & Tệp media người dùng tải lên)
# SQLite database files
*.sqlite3
*.sqlite3-journal
db.sqlite3

# User uploaded files (Media)
media/
/media/

# Static root generated by 'collectstatic' (STATIC_ROOT)
# Lưu ý: Static nguồn trong các app (như smart_crm/static/, home/static/) vẫn được commit
/static/
collected_static/

# 5. Logs & Temporary Files (Nhật ký & Tệp tạm thời)
*.log
logs/
*.pot
*.pid
tmp/
/tmp/

# 6. Testing & Code Coverage (Kiểm thử)
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# 7. IDEs & Editors (Cấu hình trình soạn thảo cá nhân)
.vscode/
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 8. Operating System Specific (Tệp hệ điều hành tự tạo)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. Docker & Container artifacts
.docker/
